<!-- 复用统一弹窗容器结构，仅保留bottom模式（日期选择器默认底部弹出） -->
<view class="popup {{show?'visible slideInUpBg ':!show & hidden? 'visible events slideOutDownBg':'hidden '}}" catch:tap="handlePopup">
  <!-- 底部模式内容区（阻断冒泡） -->
  <view class="popup-box-bottom {{show?'bottomUp':!show & hidden? 'bottomUpDown':''}}" bind:tap>
    <view class="popup-content" style="height:{{contentHeight}}">
      <!-- 筛选选项组 -->
      <view class="filter-group">
        <block wx:for="{{filterList}}" wx:key="index">
          <view 
            class="filter-item radius-4 {{activeIndex==index?'active':''}}" 
            data-type="{{item.type}}"
            data-index="{{index}}" 
            bind:tap="handleFilterTap"
          >
            {{item.name}}
          </view>
        </block>
      </view>

      <!-- 自定义日期选择器 -->
      <block wx:if="{{shouldShowPicker}}">
        <view class="picker-wrap">
          <view class='date-picker'>
            <picker-view 
              indicator-style="height: 40px;" 
              style="width: 100%; height: 240px;background-color:white;font-size: 24rpx;" 
              value="{{pickerViewValue}}" 
              bindchange="handlePickerViewChange" 
              immediate-change="{{true}}" 
              bindpickstart="handlePickStart" 
              bindpickend="handlePickEnd"
            >
              <!-- 年月日列 -->
              <picker-view-column wx:if="{{!isShowWeek && isShowYear}}">
                <view wx:for="{{years}}" wx:key="*this" class='item'>
                  <text>{{item}}年</text>
                </view>
              </picker-view-column>
              <picker-view-column wx:if="{{!isShowWeek && isShowMonth}}">
                <view wx:for="{{months}}" wx:key="*this" class='item'>
                  <text>{{item}}月</text>
                </view>
              </picker-view-column>
              <picker-view-column wx:if="{{!isShowWeek && isShowDay}}">
                <view wx:for="{{days}}" wx:key="*this" class='item'>
                  <text>{{item}}日</text>
                </view>
              </picker-view-column>

              <!-- 周模式列 -->
              <picker-view-column wx:if="{{isShowWeek}}">
                <view wx:for="{{weekDays}}" wx:key="timestamp" class='item'>
                  <text>{{item.weekName}}</text>
                </view>
              </picker-view-column>
            </picker-view>
          </view>
        </view>
      </block>
<view class="tips">{{tips}}{{selectedDate}}</view>
      <!-- 底部操作按钮 -->
      <view class="btn-group">
        <view class="btn cancel" bind:tap="handleCancel">取消</view>
        <view class="btn confirm" bind:tap="handleConfirm">确定</view>
      </view>
    </view>
  </view>
</view>