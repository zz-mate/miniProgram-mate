<!--subPackages/pages/account/list/index.wxml-->
<!--subPackages/pages/book/category/index.wxml-->
<navigation-bar title="选择账户类型" back="{{true}}" homeButton="{{false}}" auto="{{false}}" color="black"
	background="rgba(255,255,255,0.9);">
</navigation-bar>



<!-- 备忘录内容 -->


<view class="book-container">

	<view class="book-list  radius-10 ">
		<view class="book-item flex flex-align-items-center flex-space-between"  hover-class="btn-hover" hover-stay-time="50" hover-start-time="0" wx:for="{{bookCategoryList}}" wx:key="index"
			data-index="{{index}}" data-item="{{item}}" bind:tap="handleBookSelected">
			<view class="cover">
				<image src="{{item.icon|| 'https://picsum.photos/50/60?random=3'}}" mode="" />
			</view>
			<view class="info">
				<view class="book-name">{{item.name}}</view>
				<view class="book-desc">{{item.remark}}</view>
			</view>
			<view class="icon">
				<image src="/static/imgs/icon-arrow_right.png" mode="widthFix" />
			</view>
		</view>
	</view>


</view>
<z-notify id="customNotify" bind:close="onNotifyClose"/>