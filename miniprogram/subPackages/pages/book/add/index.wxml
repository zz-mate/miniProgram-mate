<!--subPackages/pages/book/add/index.wxml-->
<navigation-bar title="{{title}}" back="{{true}}" homeButton="{{false}}" auto="{{false}}" color="black"
background="{{navBgColor}}">

</navigation-bar>

<view class="book-container">
	 <view class="book-name radius-10 flex flex-align-items-center flex-space-between">
	 <view class="label">名称</view>
	 <view class="input">
		<input class="placeholder num" type="text" placeholder="请输入" maxlength="6" value="{{params.name}}"
				adjust-position="{{false}}" bindinput="bindKeyInput" />
	 </view>
	 </view>
</view>


<view class="shortcut" bind:tap="handleBookSave">
	<view class="shortcut_count radius-10 flex flex-center" >
	保存
	</view>
</view>
  <!-- 自定义 Notify 组件 -->
  <z-notify id="customNotify" bind:close="onNotifyClose"/>